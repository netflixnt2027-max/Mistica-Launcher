<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/purple_dark" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <ImageView android:id="@+id/logo" android:layout_width="match_parent" android:layout_height="145dp"
            android:contentDescription="Brasil Terra Mística" android:scaleType="centerInside"
            android:src="@drawable/logo_mistica"/>

        <TextView android:id="@+id/loading_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="CONECTANDO AO LAUNCHER..."
            android:textColor="@color/gold" android:textSize="12sp" android:textStyle="bold"/>

        <ProgressBar android:id="@+id/loading_bar" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center" android:layout_marginTop="8dp" android:indeterminate="true"/>

        <TextView android:id="@+id/welcome" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="10dp" android:text="BRASIL TERRA MÍSTICA"
            android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="4dp"
            android:text="SEU UNIVERSO RPG COMEÇA AQUI" android:textColor="@color/text_muted" android:textSize="12sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="130dp"
            android:layout_marginTop="18dp" android:background="@drawable/banner_bg"
            android:gravity="center_vertical" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DOIS SERVIDORES. UMA EXPERIÊNCIA." android:textColor="@color/gold"
                android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Escolha seu mundo e entre para jogar."
                android:textColor="@color/white" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/banner_server" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Terra Mística RP • Online"
                android:textColor="@color/text_muted" android:textSize="13sp"/>
        </LinearLayout>

        <Button android:id="@+id/play_now" android:layout_width="match_parent" android:layout_height="62dp"
            android:layout_marginTop="14dp" android:background="@drawable/play_bg"
            android:text="▶  JOGAR AGORA" android:textColor="#160D22" android:textSize="18sp" android:textStyle="bold"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="ESCOLHA SEU SERVIDOR"
            android:textColor="@color/gold" android:textSize="12sp" android:textStyle="bold"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="17dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🌌  TERRA MÍSTICA RP" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:id="@+id/terra_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="● VERIFICANDO SERVIDOR..." android:textColor="@color/gold" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/terra_players" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Jogadores: --/--" android:textColor="@color/white" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="190.102.40.7:7781" android:textColor="@color/text_muted" android:textSize="12sp"/>
            <Button android:id="@+id/terra_play" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="11dp" android:background="@drawable/play_bg" android:text="JOGAR TERRA MÍSTICA"
                android:textColor="#160D22" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="11dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="17dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔥  NEVORA RPG" android:textColor="@color/white" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:id="@+id/nevora_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="● VERIFICANDO SERVIDOR..." android:textColor="@color/gold" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/nevora_players" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Jogadores: --/--" android:textColor="@color/white" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="143.14.168.211:26558" android:textColor="@color/text_muted" android:textSize="12sp"/>
            <Button android:id="@+id/nevora_play" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="11dp" android:background="@drawable/play_bg" android:text="JOGAR NEVORA"
                android:textColor="#160D22" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <Button android:id="@+id/refresh_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="@drawable/card_button_bg" android:text="↻ ATUALIZAR" android:textColor="@color/white" android:textSize="12sp"/>
            <Button android:id="@+id/discord_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="9dp"
                android:layout_weight="1" android:background="@drawable/card_button_bg" android:text="DISCORD" android:textColor="@color/white" android:textSize="12sp"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="PRÓXIMA GMX" android:textColor="@color/gold" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/gmx" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:background="@drawable/card_bg" android:padding="14dp" android:text="Todos os dias às 06:00" android:textColor="@color/white" android:textSize="14sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="EVENTO EM DESTAQUE" android:textColor="@color/gold" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/event" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:background="@drawable/card_bg" android:padding="14dp" android:text="Aguarde novidades da administração." android:textColor="@color/white" android:textSize="14sp"/>
        <TextView android:id="@+id/updates" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:layout_marginBottom="15dp" android:background="@drawable/card_bg" android:padding="14dp"
            android:text="Versão 1.1.0 • Launcher oficial" android:textColor="@color/white" android:textSize="14sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
            android:layout_marginBottom="8dp" android:text="Brasil Terra Mística RPG • Launcher Oficial"
            android:textColor="@color/text_muted" android:textSize="10sp"/>
    </LinearLayout>
</ScrollView>